# Copy to .env and fill in. .env is git-ignored. Never commit real passwords.
# Every lab address, user, password and #tag lives here only (no defaults in code).
# A live run stops before the first test if one of them is blank.

# ---- NCP under test ----
NCP_HOST=10.4.5.236
NCP_USER=superadmin
NCP_PASSWORD=
# Default is wss://<NCP_HOST>/api/v1/ws. Older builds used wss://<host>:9001/api/v1/ws
NCP_WS_URI=
# Optional. Project chat is not wired yet (field name not confirmed) - leave blank for admin chat.
NCP_PROJECT_ID=

# ---- Connector tags used in the chat (#tag routes the prompt to that connector) ----
# Confirmed on 10.4.5.236 (2026-10-06). Case-sensitive, exactly as in the NCP UI.
TAG_NEXUS=#Nexus-mcp
TAG_CATALYST=#mcp-cat
TAG_ZABBIX=#zabbix
TAG_ONES=#ONES-MCP

# ---- Ground-truth sources (read directly, read-only) ----
NEXUS_URL=https://10.20.11.3
NEXUS_USER=
NEXUS_PASSWORD=
NEXUS_DOMAIN=DefaultAuth

CATALYST_URL=https://10.4.5.230
CATALYST_USER=
CATALYST_PASSWORD=

ZABBIX_URL=http://10.4.4.177:8088
ZABBIX_USER=
ZABBIX_PASSWORD=

ONES_URL=https://10.4.4.181
ONES_USER=
ONES_PASSWORD=
# Optional: an ONES endpoint that lists links (LLDP neighbours). Blank = link check BLOCKED.
ONES_LINKS_PATH=

# ---- Device used for the <DEVICE> prompts (blank = picked automatically) ----
DEVICE_NEXUS=
DEVICE_CATALYST=
DEVICE_ZABBIX=
DEVICE_ONES=

# ---- Compare tolerances (absolute) ----
CPU_TOL=10
MEM_TOL=3
TEMP_TOL=3

# ---- Optional LLM judge: adds a second-opinion note, never changes a result ----
JUDGE_URL=
JUDGE_MODEL=gpt-oss-120b

# ---- Optional chat tuning (blank = the default shown) ----
# After NCP's end frame (agent_complete), wait this long for late content, then stop. Default 3
WS_END_GRACE_SECONDS=
# Only used if NCP sends no end frame: this much silence after text ends the answer. Default 45
WS_QUIET_SECONDS=
# Attempts per prompt on connection errors (connect / auth / closed). Default 3
CHAT_RETRIES=
# Repeats when NCP was asked but gave no answer in time / an empty answer. Default 1
ANSWER_RETRIES=
# Follow-up questions answered per prompt. Default 3
MAX_FOLLOWUPS=
